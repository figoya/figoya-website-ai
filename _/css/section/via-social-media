@media only screen {

  .c.via-social-media.items ul {
    display: flex;
    gap: 2rem;
  }
  .c.via-social-media.items li img {
    height: 4rem;
    filter: invert(1);
  }
  .c.via-social-media.items li a:hover img {
    height: 4rem;
    filter: invert(.5);
  }
  .c.via-social-media.items li {
    flex-basis: 4rem;
  }

}
